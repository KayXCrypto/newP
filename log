// --- Hỗ trợ so sánh mật khẩu (hiện chưa dùng vì đăng nhập qua LDAP) ---
function safeEqual(a, b) {
    const ha = crypto.createHash('sha256').update(String(a)).digest();
    const hb = crypto.createHash('sha256').update(String(b)).digest();
    return crypto.timingSafeEqual(ha, hb);
}

// ===========================================================================
// 5. ĐẨY DỮ LIỆU ĐỊNH KỲ LÊN MQTT
// ===========================================================================
const pad = n => String(n).padStart(2, '0');
function nowString() {
    const d = new Date();
    return `${d.getFullYear()}/${pad(d.getMonth() + 1)}/${pad(d.getDate())} ` +
        `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
}

// Gói gửi đi: { camera: { abnormal, normal, covered, ... }, nvr: { abnormal, normal }, ..., updateTime }
let syncingDashboard = false;
async function syncDashboardData() {
    if (syncingDashboard) return;        // tránh chạy chồng nếu DB chậm
    syncingDashboard = true;
    try {
        const dashboardData = {};

        for (const key of DASHBOARD_KEYS) {
            const queries = Q.dashboard[key];
            try {
                const fields = Object.keys(queries);
                const results = await Promise.all(fields.map(f => pool.query(queries[f])));

                dashboardData[key] = {};
                fields.forEach((f, i) => {
                    dashboardData[key][f] = parseInt(results[i].rows[0]?.count || 0, 10);
                });
            } catch (err) {
                logger.error(`Dashboard query failed for [${key}]`, err.message);
            }
        }

        dashboardData.updateTime = nowString();
        mqttClient.publish(`${TOPIC}/dashboard`, JSON.stringify(dashboardData), { retain: true });
    } finally {
        syncingDashboard = false;
    }
}

async function syncContacts() {
    if (!Q.it_contact) return;
    try {
        const r = await pool.query(Q.it_contact);
        mqttClient.publish(`${TOPIC}/contacts`, JSON.stringify(r.rows), { retain: true });
    } catch (err) {
        logger.error('Contact query failed', err.message);
    }
}

// config.queries.getTimes = { camera: "select ... as updatedate ...", ... }
// Gửi { camera: "2026-11-16 09:00:00", ... } để index.html gán vào <key>-time-value
async function syncGettime() {
    const out = {};
    for (const [key, sql] of Object.entries(Q.getTimes || {})) {
        if (!sql || String(sql).trim() === '') continue;
        try {
            const r = await pool.query(sql);
            out[key] = r.rows[0]?.updatedate || 'N/A';
        } catch (err) {
            logger.error(`Get time query failed for [${key}]`, err.message);
        }
    }
    if (Object.keys(out).length) {
        mqttClient.publish(`${TOPIC}/gettimes`, JSON.stringify(out), { retain: true });
    }
}

const syncAll = () => Promise.allSettled([syncDashboardData(), syncContacts(), syncGettime()]);

// ===========================================================================
// 6. MQTT REQUEST / RESPONSE
// ===========================================================================
const mqttClient = mqtt.connect(MQTT_URL);
const REQUEST_ACTIONS = ['detail', 'subdetail', 'all_detail', 'gettime', 'update_camera_abnormal', 'update_exception'];

mqttClient.on('connect', () => {
    logger.success(`Backend connected to MQTT Broker (${MQTT_URL}) | base topic: ${TOPIC}`);
    REQUEST_ACTIONS.forEach(a => mqttClient.subscribe(`${TOPIC}/request/${a}`));
    syncAll();
});
mqttClient.on('error', err => logger.error('MQTT error', err.message));
mqttClient.on('reconnect', () => logger.warn('MQTT reconnecting...'));

setInterval(syncAll, SYNC_INTERVAL_MS);

// SQL chỉ lấy từ config theo `type` (whitelist) -> client không thể chèn SQL
function resolveReadQuery(action, type, id) {
    switch (action) {
        case 'detail':     // cấp 1: danh sách lỗi. camera / camera_offline / camera_covered ... đều tra ở đây
            return { sql: Q.detail?.[type], params: [] };
        case 'subdetail':  // cấp 2: chi tiết từng người / thiết bị
            return { sql: Q.sub_detail?.[type], params: [id] };
        case 'all_detail': // nút View All
            return { sql: Q.allQueries?.[type], params: [] };
        default:
            return { sql: null, params: [] };
    }
}

// ---------------------------------------------------------------------------
// Ghi chú / lý do loại trừ camera
//   update_exception       : cập nhật excludecamera + excludeupdatedate
//   update_camera_abnormal : cập nhật excludecamera; excludecreatedate chỉ ghi lần đầu
// ---------------------------------------------------------------------------
async function handleUpdate(action, p) {
    const { nvr_ip, nvr_cameraid, remark } = p;
    if (!nvr_ip || nvr_cameraid === undefined || nvr_cameraid === null || nvr_cameraid === '') {
        return { success: false, error: 'Missing nvr_ip or nvr_cameraid' };
    }

    const remarkVal = (typeof remark === 'string' && remark.trim() !== '') ? remark.trim() : null;
    const camId = String(nvr_cameraid);
    const now = new Date();

    if (action === 'update_exception') {
        const sql = Q.update?.exception || DEFAULT_EXCEPTION_SQL;
        const r = await pool.query(sql, [remarkVal, now, nvr_ip, camId]);
        return { success: true, rowCount: r.rowCount };
    }

    if (action === 'update_camera_abnormal') {
        // Nếu config có câu riêng thì dùng đúng câu đó (cùng thứ tự tham số)
        if (Q.update?.camera_abnormal) {
            const r = await pool.query(Q.update.camera_abnormal, [remarkVal, now, nvr_ip, camId]);
            return { success: true, rowCount: r.rowCount };
        }

        // Mặc định: lần đầu ghi remark thì set cả excludecreatedate, các lần sau chỉ sửa remark
        const check = await pool.query(CAMERA_CHECK_SQL, [nvr_ip, camId]);
        const hasCreate = !!check.rows[0]?.excludecreatedate;
        const r = hasCreate
            ? await pool.query(CAMERA_NEXT_SQL, [remarkVal, nvr_ip, camId])
            : await pool.query(CAMERA_FIRST_SQL, [remarkVal, now, nvr_ip, camId]);
        return { success: true, rowCount: r.rowCount };
    }

    return { success: false, error: `${action} is not supported` };
}

mqttClient.on('message', async (topic, message) => {
    const prefix = `${TOPIC}/request/`;
    if (!topic.startsWith(prefix)) return;
    const action = topic.slice(prefix.length);

    // Client yêu cầu làm mới thời gian cập nhật (không có requestId)
    if (action === 'gettime') {
        await syncGettime();
        return;
    }

    let payload;
    try {
        payload = JSON.parse(message.toString());
    } catch {
        logger.warn(`Failed to parse JSON on topic: ${topic}`);
        return;
    }

    const { type, id, requestId } = payload;
    if (!requestId) return;
    const responseTopic = `${TOPIC}/response/${requestId}`;

    try {
        // --- Ghi chú camera ---
        if (action === 'update_camera_abnormal' || action === 'update_exception') {
            let result;
            try {
                result = await handleUpdate(action, payload);
            } catch (err) {
                logger.error(`${action} failed`, err.message);
                result = { success: false, error: err.message };
            }

            mqttClient.publish(responseTopic, JSON.stringify({ requestId, ...result }));
            logger.info(`${action} ${payload.nvr_ip}/${payload.nvr_cameraid} -> ${result.success ? `OK (rows: ${result.rowCount})` : result.error}`);

            // Cập nhật ngay số liệu dashboard + thời gian để người dùng thấy kết quả mới
            if (result.success) {
                await syncDashboardData();
                await syncGettime();
            }
            return;
        }

        // --- Đọc dữ liệu chi tiết ---
        const { sql, params } = resolveReadQuery(action, type, id);
        logger.info(`REQUEST => action=${action}, type=${type}`);

        if (!sql) {
            logger.warn(`No query configured for ${action} [${type}]`);
            mqttClient.publish(responseTopic, JSON.stringify({
                requestId, rows: [], success: false, error: `Missing SQL config for ${type}`
            }));
            return;
        }

        let rows = [];
        try {
            const res = await pool.query(sql, params);
            rows = Array.isArray(res?.rows) ? res.rows.map(o => Object.values(o)) : [];  // Object -> Array cho renderTable
            logger.info(`[${type}] returned ${rows.length} rows`);
        } catch (sqlErr) {
            logger.error(`SQL execution error [${type}]`, sqlErr.message);
            mqttClient.publish(responseTopic, JSON.stringify({
                requestId, rows: [], success: false, error: sqlErr.message
            }));
            return;
        }

        mqttClient.publish(responseTopic, JSON.stringify({ requestId, rows }));
        logger.info(`Replied ${action} [${type}] - Rows: ${rows.length}`);
    } catch (err) {
        logger.error(`Error handling ${action} [${type}]`, err.message);
        // Luôn trả lời để giao diện không bị treo
        mqttClient.publish(responseTopic, JSON.stringify({ requestId, rows: [], success: false, error: err.message }));
    }
});

// =================================================
// LDAP LOGIN API
// =================================================
app.post('/api/login', async (req, res) => {
    try {
        const { username, password } = req.body;

        if (!username || !password) {
            return res.status(400).json({ success: false, message: 'Missing username or password' });
        }

        // Bước 1: Kiểm tra AD
        const isAuthenticated = await authenticateLDAP(username, password);
        if (!isAuthenticated) {
            return res.status(401).json({ success: false, message: 'Sai tài khoản hoặc mật khẩu Domain' });
        }

        // Bước 2: Kiểm tra user trong DB
        const userResult = await pool.query(
            `SELECT *
             FROM itsec_itcontactlist
             WHERE LOWER(empid) = LOWER($1)
               AND emptype in ('admin','user_admin')`,
            [username]
        );
        if (userResult.rows.length === 0) {
            return res.status(403).json({ success: false, message: 'Tài khoản chưa được cấp quyền sử dụng hệ thống' });
        }

        const user = userResult.rows[0];

        // Bước 3: So sánh username
        if (user.empid.trim().toLowerCase() !== username.trim().toLowerCase()) {
            return res.status(403).json({ success: false, message: 'Thông tin tài khoản không khớp' });
        }

        return res.json({
            success: true,
            message: 'Đăng nhập thành công',
            user: {
                username: user.username,
                fullname: user.fullname,
                department: user.department,
                role: user.role
            }
        });
    } catch (err) {
        console.error(err);
        return res.status(500).json({ success: false, message: err.message });
    }
});

