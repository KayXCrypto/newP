// --- 1. HÀM PUBLISH DỮ LIỆU TỔNG QUÁT (DASHBOARD) ---
async function syncDashboardData() {
    logger.info('Starting scheduled Dashboard data synchronization...');
    // Đã xóa 'cameraexception' khỏi mảng keys để tránh chạy thừa vòng lặp
    const keys = ['face', 'nvr', 'hr_face', 'hr_door', 'accesscontrol', 'perm', 'camera', 'magnetdoor', 'visitor'];
    let dashboardData = {};

    for (const key of keys) {
        if (key === 'cameraexception' || key === 'cameraException') continue;
        const queries = config?.queries?.dashboard?.[key];
        if (!queries) continue;

        try {
            // Nếu là camera và có cấu hình query exception riêng trong config.json
            if (key === 'camera' && config?.queries?.dashboard?.cameraexception) {
                const qException = config.queries.dashboard.cameraexception;
                const [resAbnormal, resNormal, resException] = await Promise.all([
                    pool.query(queries.abnormal),
                    pool.query(queries.normal),
                    pool.query(qException.abnormal) // Giả định câu lệnh đếm exception của bạn nằm ở đây
                ]);

                dashboardData[key] = {
                    abnormal: parseInt(resAbnormal.rows[0]?.count || 0),
                    normal: parseInt(resNormal.rows[0]?.count || 0),
                    exception: parseInt(resException.rows[0]?.count || 0) // Gộp chung vào cấu trúc của camera
                };
            } else {
                // Các thiết bị khác giữ nguyên logic cũ
                const [resAbnormal, resNormal] = await Promise.all([
                    pool.query(queries.abnormal),
                    pool.query(queries.normal)
                ]);

                dashboardData[key] = {
                    abnormal: parseInt(resAbnormal.rows[0]?.count || 0),
                    normal: parseInt(resNormal.rows[0]?.count || 0)
                };
            }
        } catch (err) {
            logger.error(`Dashboard database query failed for key [${key}]:`, err.message);
        }
    }

    // Định dạng thời gian: YYYY/MM/DD HH:mm:ss
    const now = new Date();
    const day = String(now.getDate()).padStart(2, '0');
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const year = now.getFullYear();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');

    dashboardData.updateTime = `${year}/${month}/${day} ${hours}:${minutes}:${seconds}`;

    // Publish dữ liệu tổng quan lên MQTT kèm thuộc tính retain
    mqttClient.publish(`${TOPIC_PREFIX}/dashboard`, JSON.stringify(dashboardData), { retain: true });
    logger.success(`Published global Dashboard updates. Time Stamp: ${dashboardData.updateTime}`);
}


async function syncContacts() {
    try {
        const r = await pool.query(config.queries.it_contact);
        mqttClient.publish(`${TOPIC_PREFIX}/contacts`, JSON.stringify(r.rows), { retain: true });
        logger.success(`Published Contacts database list. Total items: ${r.rows.length}`);
    } catch (err) {
        logger.error('IT Contacts database query failed:', err.message);
    }
}

// --- 3. HÃ€M Láº¤Y THá»œI GIAN Cáº¬P NHáº¬T Tá»ªNG Há»† THá»NG ---
async function syncGettime() {
    const keys = ['face', 'nvr', 'hr_face', 'hr_door', 'accesscontrol', 'perm', 'camera', 'magnetdoor', 'visitor', 'cameraexception'];
    let timesData = {};

    for (const key of keys) {
        const sql = config?.queries?.getTimes?.[key];
        if (!sql || sql.trim() === "") continue;

        try {
            const r = await pool.query(sql);
            timesData[key] = r.rows[0]?.updatedate || 'N/A';
        } catch (err) {
            logger.error(`Get Time query failed for [${key}]:`, err.message);
        }
    }

    if (Object.keys(timesData).length > 0) {
        mqttClient.publish(`${TOPIC_PREFIX}/gettimes`, JSON.stringify(timesData), { retain: true });
        logger.success(`Published system sync times:`, JSON.stringify(timesData));
    }
}

