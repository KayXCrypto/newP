mqttClient.on('message', async (topic, message) => {
    if (topic === `${TOPIC_PREFIX}/request/gettime`) {
        logger.info('ðŸ“¥ [MQTT Request] Received on-demand update-time sync request from client');
        await syncGettime();
        return;
    }

    let payload;
    try {
        payload = JSON.parse(message.toString());
    } catch (e) {
        logger.warn(` Failed to parse incoming JSON package on topic: ${topic}`);
        return;
    }

    const { type, id, requestId } = payload;
    if (!requestId) {
        logger.warn(` Request on [${topic}] rejected: Missing required 'requestId' attribute.`);
        return;
    }

    logger.info(` [MQTT Request] Topic: "${topic}" | Type: "${type || 'N/A'}" | ID: "${id || 'N/A'}"`);

    const responseTopic = `${TOPIC_PREFIX}/response/${requestId}`;
    let resultRows = [];

    try {
        let sql = '';
        let params = [];

        if (topic === `${TOPIC_PREFIX}/request/detail`) {
            sql = config.queries.detail[type];
        }
        else if (topic === `${TOPIC_PREFIX}/request/subdetail`) {
            sql = config.queries.sub_detail?.[type];
            params = [id];
        }
        else if (topic === `${TOPIC_PREFIX}/request/all_detail`) {
            sql = config.queries.allQueries?.[type];
        }
        // --- CẬP NHẬT REMARK + EXCLUDEUPDATEDATE CHO CAMERA EXCEPTION ---
        else if (topic === `${TOPIC_PREFIX}/request/update_exception`) {
            const { nvr_ip, nvr_cameraid, remark } = payload;
            if (!nvr_ip || !nvr_cameraid) {
                mqttClient.publish(responseTopic, JSON.stringify({ requestId, success: false, error: 'Missing nvr_ip or nvr_cameraid' }));
                return;
            }
            try {
                const remarkVal = (remark && remark.trim() !== '') ? remark.trim() : null;
                const now = new Date();
                const updateSql = `UPDATE itsec_camera_offline SET excludecamera = $1, excludeupdatedate = $2 WHERE nvr_ip = $3 AND nvr_cameraid = $4`;
                const updateRes = await pool.query(updateSql, [remarkVal, now, nvr_ip, nvr_cameraid]);
                logger.success(`Updated remark+excludeupdatedate for camera [${nvr_cameraid}] on NVR [${nvr_ip}]. Rows: ${updateRes.rowCount}`);
                mqttClient.publish(responseTopic, JSON.stringify({ requestId, success: true, rowCount: updateRes.rowCount }));
                // Đồng bộ ngay dữ liệu
                await syncDashboardData();
                await syncGettime();
            } catch (err) {
                logger.error('Update remark (exception) failed:', err.message);
                mqttClient.publish(responseTopic, JSON.stringify({ requestId, success: false, error: err.message }));
            }
            return;
        }
        // --- CẬP NHẬT REMARK + EXCLUDECREATEDATE CHO CAMERA ABNORMAL ---
        else if (topic === `${TOPIC_PREFIX}/request/update_camera_abnormal`) {
            const { nvr_ip, nvr_cameraid, remark } = payload;
            if (!nvr_ip || !nvr_cameraid) {
                mqttClient.publish(responseTopic, JSON.stringify({ requestId, success: false, error: 'Missing nvr_ip or nvr_cameraid' }));
                return;
            }
            try {
                const remarkVal = (remark && remark.trim() !== '') ? remark.trim() : null;
                const now = new Date();
                // excludecreatedate chỉ ghi lần đầu (khi chưa có giá trị), sau đó không ghi đè
                const checkSql = `SELECT excludecreatedate FROM itsec_camera_offline WHERE nvr_ip = $1 AND nvr_cameraid = $2`;
                const checkRes = await pool.query(checkSql, [nvr_ip, nvr_cameraid]);
                const existingCreate = checkRes.rows[0]?.excludecreatedate;

                let updateSql, updateParams;
                if (!existingCreate) {
                    // Lần đầu ghi remark → set cả excludecreatedate
                    updateSql = `UPDATE itsec_camera_offline SET excludecamera = $1, excludecreatedate = $2 WHERE nvr_ip = $3 AND nvr_cameraid = $4`;
                    updateParams = [remarkVal, now, nvr_ip, nvr_cameraid];
                } else {
                    // Đã có excludecreatedate → chỉ cập nhật remark
                    updateSql = `UPDATE itsec_camera_offline SET excludecamera = $1 WHERE nvr_ip = $2 AND nvr_cameraid = $3`;
                    updateParams = [remarkVal, nvr_ip, nvr_cameraid];
                }

                const updateRes = await pool.query(updateSql, updateParams);
                logger.success(`Updated excludecamera (abnormal) for camera [${nvr_cameraid}] on NVR [${nvr_ip}]. Rows: ${updateRes.rowCount}`);
                mqttClient.publish(responseTopic, JSON.stringify({ requestId, success: true, rowCount: updateRes.rowCount }));
                
                // Đồng bộ ngay dữ liệu
                await syncDashboardData();
                await syncGettime();
            } catch (err) {
                logger.error('Update excludecamera (abnormal) failed:', err.message);
                mqttClient.publish(responseTopic, JSON.stringify({ requestId, success: false, error: err.message }));
            }
            return;
        }

        if (sql) {
            const res = await pool.query(sql, params);

            // Kiểm tra nếu res và res.rows thực sự tồn tại và là một mảng dữ liệu
            if (res && Array.isArray(res.rows)) {
                resultRows = res.rows.map(o => Object.values(o));
            } else {
                logger.warn(`⚠️ Database trả về dữ liệu trống hoặc không đúng định dạng cho loại: [${type}]`);
                resultRows = [];
            }
        }

        mqttClient.publish(responseTopic, JSON.stringify({
            requestId,
            rows: resultRows
        }));

        logger.success(` [MQTT Response] Sent data back to client via [${responseTopic}] - Total rows: ${resultRows.length}`);

    } catch (err) {
        logger.error(` DB Execution failure handling topic [${topic}]:`, err.message);
        mqttClient.publish(responseTopic, JSON.stringify({ requestId, rows: [], error: err.message }));
    }
});

