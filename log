// Các thẻ trên dashboard lấy trực tiếp từ config.queries.dashboard (thêm thẻ mới chỉ cần sửa config).
// Mỗi thẻ có thể có nhiều câu SQL, mỗi câu trả về cột "count":
//   camera: abnormal (offline), normal, covered (bị che), rotated, black, white, exception ...
const DASHBOARD_KEYS = Object.keys(Q.dashboard || {});

// ---------------------------------------------------------------------------
// Câu UPDATE ghi chú camera.
//   - Ghi đè được bằng config.queries.update.exception / .camera_abnormal
//   - Nếu config không có thì dùng câu mặc định bên dưới (giống bản server cũ)
//   Tham số luôn theo thứ tự: $1 = remark, $2 = thời điểm cập nhật, $3 = nvr_ip, $4 = nvr_cameraid
// ---------------------------------------------------------------------------
const CAMERA_TABLE = 'itsec_camera_offline';

const DEFAULT_EXCEPTION_SQL =
    `UPDATE ${CAMERA_TABLE} SET excludecamera = $1, excludeupdatedate = $2 WHERE nvr_ip = $3 AND nvr_cameraid = $4`;

// Camera bất thường: excludecreatedate chỉ ghi lần đầu (khi chưa có), các lần sau chỉ sửa remark
const CAMERA_CHECK_SQL =
    `SELECT excludecreatedate FROM ${CAMERA_TABLE} WHERE nvr_ip = $1 AND nvr_cameraid = $2`;
const CAMERA_FIRST_SQL =
    `UPDATE ${CAMERA_TABLE} SET excludecamera = $1, excludecreatedate = $2 WHERE nvr_ip = $3 AND nvr_cameraid = $4`;
const CAMERA_NEXT_SQL =
    `UPDATE ${CAMERA_TABLE} SET excludecamera = $1 WHERE nvr_ip = $2 AND nvr_cameraid = $3`;

// Kiểm tra config lúc khởi động để phát hiện thiếu SQL sớm
(function validateConfig() {
    if (!config.db) logger.warn('config.db is missing');
    if (!DASHBOARD_KEYS.length) logger.warn('config.queries.dashboard is empty');

    const cam = Q.dashboard?.camera || {};
    ['abnormal', 'normal', 'covered'].forEach(k => {
        if (!cam[k]) logger.warn(`dashboard.camera.${k} is missing (số trên vòng tròn camera sẽ không có)`);
    });
    ['camera', 'camera_offline', 'camera_covered'].forEach(k => {
        if (!Q.detail?.[k]) logger.warn(`detail.${k} is missing (nút lọc camera sẽ trả bảng trống)`);
    });
    if (!Q.update?.exception) logger.info('queries.update.exception not set -> dùng câu UPDATE mặc định');
})();

// ===========================================================================
// 3. DATABASE
// ===========================================================================
const pool = new Pool({
    ...config.db,
    options: '-c timezone=Asia/Ho_Chi_Minh'
});
pool.on('error', err => logger.error('Unexpected PG pool error', err.message));

// ---- LDAP ----
function authenticateLDAP(username, password) {
    return new Promise((resolve) => {
        const client = ldap.createClient({ url: 'ldap://10.69.22.12' });
        const userPrincipalName = `WIH\\${username}`;

        client.bind(userPrincipalName, password, (err) => {
            if (err) {
                console.error('LDAP Login Failed:', err.message);
                client.destroy();
                return resolve(false);
            }
            client.unbind();
            resolve(true);
        });
    });
}

